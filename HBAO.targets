<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- 设置基础路径（.targets 所在目录为 build\native）-->
  <PropertyGroup>
    <HBAO_PackageRoot>$(MSBuildThisFileDirectory)</HBAO_PackageRoot>
    <HBAO_Include>$(HBAO_PackageRoot)include</HBAO_Include>
    <HBAO_LibDir>$(HBAO_PackageRoot)lib</HBAO_LibDir>
    <HBAO_BinDir>$(HBAO_PackageRoot)bin</HBAO_BinDir>
  </PropertyGroup>

  <!-- 添加 include、lib 搜索路径，链接 lib -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(HBAO_Include);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(HBAO_LibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>GFSDK_SSAO_D3D12.win64.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- 拷贝 DLL 到输出目录 -->
  <ItemGroup>
    <HBAO_Dlls Include="$(HBAO_BinDir)\GFSDK_SSAO_D3D12.win64.dll" />
  </ItemGroup>

  <Target Name="CopyHBAODll" AfterTargets="Build">
    <Copy
      SourceFiles="@(HBAO_Dlls)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
